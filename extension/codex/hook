#!/bin/sh
# Promote: records what Codex is doing on its tmux pane (@promote-status), so the sidebar
# status is exact instead of guessed from the screen. Does nothing outside tmux, prints
# nothing, so Codex's own prompts decide as usual.
# Installed to ~/.config/promote/codex/hook from Promote's menu: Promote > Live Agent Status.
[ -n "$TMUX_PANE" ] || exit 0
tmux=$(command -v tmux || echo /opt/homebrew/bin/tmux)
case "$1" in
  UserPromptSubmit|PostToolUse) s=working ;;
  PermissionRequest) s=blocked ;;
  # Codex reports Esc itself: you stopped it, the turn is over
  Stop|Interrupt) s=done ;;
  SessionStart) "$tmux" set-option -p -u -t "$TMUX_PANE" @promote-status 2>/dev/null; exit 0 ;;
  *) exit 0 ;;
esac
"$tmux" set-option -p -t "$TMUX_PANE" @promote-status "codex $s $(date +%s)" 2>/dev/null
exit 0
