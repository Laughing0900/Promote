#!/bin/sh
# Promote: records what Claude Code is doing on its tmux pane (@promote-status), so the
# sidebar status is exact instead of guessed from the screen. Does nothing outside tmux.
# Installed to ~/.config/promote/claudecode/hook from Promote's menu: Promote > Live Agent Status.
[ -n "$TMUX_PANE" ] || exit 0
tmux=$(command -v tmux || echo /opt/homebrew/bin/tmux)
case "$1" in
  UserPromptSubmit) s=working ;;
  # a subagent's tool call must not settle what the session itself asks
  PostToolUse) grep -q '"agent_id"' && exit 0; s=working ;;
  PermissionRequest|PreToolUse) s=blocked ;;
  Stop) s=done ;;
  StopFailure) s=failed ;;
  SessionStart|SessionEnd) "$tmux" set-option -p -u -t "$TMUX_PANE" @promote-status 2>/dev/null; exit 0 ;;
  *) exit 0 ;;
esac
"$tmux" set-option -p -t "$TMUX_PANE" @promote-status "claude $s $(date +%s)" 2>/dev/null
exit 0
